# Clean Neon installations use this backend setting at build time and runtime.
# Set it to "supabase" for an existing Supabase consumer.
# See docs/NEON.md in the Core repository for database and Data API setup.
NEXT_PUBLIC_SAAS_CORE_BACKEND="neon"
SAAS_CORE_DATA_TRANSPORT="postgres"
SAAS_CORE_DATA_DATABASE_URL=
SAAS_CORE_DATA_POOL_MAX=4
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_DATA_API_URL=
SAAS_CORE_DATA_AUDIENCE=
SAAS_CORE_DATA_SIGNING_KEY=
SAAS_CORE_AUTH_URL=
SAAS_CORE_AUTH_SECRET=
SAAS_CORE_GOOGLE_CLIENT_ID=
SAAS_CORE_GOOGLE_CLIENT_SECRET=

# __PRODUCT_NAME__ environment template
# Copy to .env.local. Fill Supabase local values from:
#   pnpm exec supabase status --workdir . -o env
# Never commit real secrets.

# ----------------------------------------------------------------------------
# Supabase: server-only credentials
# ----------------------------------------------------------------------------
SUPABASE_URL="http://127.0.0.1:55521"
SUPABASE_SERVICE_ROLE_KEY="your_local_service_role_key"
SUPABASE_ANON_KEY="your_local_anon_key"
SUPABASE_JWT_SECRET="your_local_jwt_secret"

# ----------------------------------------------------------------------------
# Supabase: browser-safe values and application URLs
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:55521"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_local_anon_key"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SAAS_CORE_APP_DOMAIN="app.__PRODUCT_SLUG__.local"

# ----------------------------------------------------------------------------
# Isolated local development
# ----------------------------------------------------------------------------
SAAS_CORE_APP_URL="http://localhost:3000"
SAAS_CORE_MAILPIT_PORT="55524"
SAAS_CORE_MAIL_URL="http://127.0.0.1:55524"
NEXT_PUBLIC_DEV_MAILPIT_URL="http://localhost:55524"
SAAS_CORE_ROOT_DOMAIN="__PRODUCT_SLUG__.local"
SAAS_CORE_APP_DOMAIN="app.__PRODUCT_SLUG__.local"

# One-time platform owner bootstrap. Use a verified local Auth email.
PLATFORM_OWNER_EMAIL="owner@example.com"

# ----------------------------------------------------------------------------
# Optional custom domains (Vercel provider)
# ----------------------------------------------------------------------------
# Enable only behind an ingress that replaces the forwarded hostname.
SAAS_CORE_TRUST_FORWARDED_HOST=false
SAAS_CORE_CUSTOM_DOMAIN_TARGET=
VERCEL_API_TOKEN="vercel_api_token_placeholder"
VERCEL_PROJECT_ID="prj_product_project_id_placeholder"
VERCEL_TEAM_ID="team_product_team_id_placeholder"

# ----------------------------------------------------------------------------
# Billing (optional; use Sandbox during development)
# ----------------------------------------------------------------------------
# Set to "deferred" to block customer-initiated billing changes while leaving
# signed webhooks and subscription reconciliation active. Paddle is the
# default for new checkout. Set "stripe" to keep using Stripe for new checkout.
SAAS_CORE_BILLING_PROVIDER="paddle"
SAAS_CORE_BILLING_MODE=
STRIPE_ENVIRONMENT="sandbox"
STRIPE_SECRET_KEY="rk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
STRIPE_ACCOUNT_ID="acct_sandbox_account_id"
STRIPE_BILLING_PORTAL_CONFIGURATION_ID="bpc_sandbox_configuration_id"
# Paddle uses a client-side checkout token and separate server credentials.
PADDLE_ENVIRONMENT="sandbox"
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Hosted Paddle requires an exact HTTPS application origin.
PADDLE_APP_ORIGIN=
PADDLE_ACCOUNT_ID=
PADDLE_LIVE_CHECKOUT_MODE="disabled"
PADDLE_LIVE_CHECKOUT_WORKSPACE_ID=
CRON_SECRET="random_server_only_cron_secret"
BILLING_RECONCILE_DRY_RUN="true"
BILLING_ALLOW_LIVE_PRICE_REGISTRATION="false"
BILLING_ALLOW_LIVE_RECONCILE="false"

# ----------------------------------------------------------------------------
# Transactional email via Resend (optional; Mailpit is the local default)
# ----------------------------------------------------------------------------
RESEND_API_KEY="re_placeholder"
RESEND_WEBHOOK_SECRET="whsec_placeholder"
MANAGEMENT_EMAIL="ops@example.com"
SAAS_CORE_SYSTEM_EMAIL_FROM="__PRODUCT_NAME__ <noreply@example.com>"
SAAS_CORE_SYSTEM_EMAIL_REPLY_TO="support@example.com"

# ----------------------------------------------------------------------------
# Web Push (optional)
# ----------------------------------------------------------------------------
WEB_PUSH_PUBLIC_KEY="your_vapid_public_key"
WEB_PUSH_PRIVATE_KEY="your_vapid_private_key"
WEB_PUSH_SUBJECT="mailto:ops@example.com"

# ----------------------------------------------------------------------------
# Privacy notice
# ----------------------------------------------------------------------------
PRIVACY_NOTICE_VERSION="YYYY-MM-DD-v1"
PRIVACY_NOTICE_DATA_CONTROLLER_NAME="__PRODUCT_NAME__"
PRIVACY_NOTICE_COUNTRY="Türkiye"
PRIVACY_NOTICE_CONTACT_EMAIL="support@example.com"
PRIVACY_NOTICE_CONTACT_PHONE="+00 000 000 0000"
PRIVACY_NOTICE_CONTACT_ADDRESS="Your business address"
PRIVACY_NOTICE_RETENTION_PERIOD="Describe the applicable retention period"
PRIVACY_NOTICE_RECIPIENTS="Your business and authorized service providers"

# Optional managed Chromium path. Leave empty to use the installed browser.
SAAS_CORE_SCREENSHOT_EXECUTABLE_PATH=
