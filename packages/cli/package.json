{
  "name": "@sapienx/saas-core-cli",
  "version": "1.1.0",
  "description": "The saas-core command line interface",
  "type": "module",
  "bin": {
    "saas-core": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "pack": "pnpm build && pnpm pack --pack-destination ../../artifacts"
  },
  "dependencies": {
    "@sapienx/saas-core": "workspace:*"
  }
}
