{
  "name": "@sapienx/saas-core-runtime",
  "version": "1.1.2",
  "description": "Server-safe Supabase runtime and persistence services for SaaS Core",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "pack": "pnpm build && pnpm pack --pack-destination ../../artifacts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@sapienx/saas-core": "workspace:*"
  }
}
