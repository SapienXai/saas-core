# SaaS Core environment template
# Copy to .env.local for local work. Never commit real secrets.

# ----------------------------------------------------------------------------
# Supabase: server-only credentials
# ----------------------------------------------------------------------------
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"
SUPABASE_ANON_KEY="your_server_anon_key"
SUPABASE_JWT_SECRET="your_supabase_jwt_secret"

# ----------------------------------------------------------------------------
# Supabase: browser-safe values and application URLs
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_client_anon_key"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SAAS_CORE_APP_DOMAIN="app.saas-core.example.com"

# ----------------------------------------------------------------------------
# Local development
# The root checkout uses the 556xx Supabase project ports. A generated
# consumer uses its isolated 555xx ports; see its own .env.example.
# ----------------------------------------------------------------------------
SAAS_CORE_APP_URL="http://localhost:3000"
SAAS_CORE_MAILPIT_PORT="55624"
SAAS_CORE_MAIL_URL="http://127.0.0.1:55624"
NEXT_PUBLIC_DEV_MAILPIT_URL="http://localhost:55624"

# ----------------------------------------------------------------------------
# Core routing and platform administration
# ----------------------------------------------------------------------------
SAAS_CORE_ROOT_DOMAIN="saas-core.example.com"
SAAS_CORE_APP_DOMAIN="app.saas-core.example.com"
PLATFORM_OWNER_EMAIL="owner@example.com"

# ----------------------------------------------------------------------------
# Optional custom domains (Vercel provider)
# ----------------------------------------------------------------------------
# Exact CNAME target customers should use. Leave empty until the DNS alias is
# configured and points to the Vercel project's real target.
SAAS_CORE_CUSTOM_DOMAIN_TARGET=
VERCEL_API_TOKEN="vercel_api_token_placeholder"
VERCEL_PROJECT_ID="prj_saas_core_project_id_placeholder"
VERCEL_TEAM_ID="team_saas_core_team_id_placeholder"

# ----------------------------------------------------------------------------
# Paddle Billing (server-side secrets; use sandbox during development)
# ----------------------------------------------------------------------------
# Set to "deferred" to disable Paddle checkout, server actions, and webhook
# processing while a product migrates billing providers. Unset for deliberate
# local Sandbox verification.
SAAS_CORE_BILLING_MODE=
PADDLE_ENVIRONMENT="sandbox"
PADDLE_API_KEY="pdl_sandbox_api_key_placeholder"
PADDLE_WEBHOOK_SECRET="paddle_webhook_secret"
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="test_client_token_placeholder"
CRON_SECRET="random_server_only_cron_secret"
# Keep live operations opt-in and dry-run reconciliation by default.
BILLING_RECONCILE_DRY_RUN="true"
BILLING_ALLOW_LIVE_PRICE_REGISTRATION="false"
BILLING_ALLOW_LIVE_RECONCILE="false"

# ----------------------------------------------------------------------------
# Transactional email via Resend
# ----------------------------------------------------------------------------
RESEND_API_KEY="re_placeholder"
RESEND_WEBHOOK_SECRET="whsec_placeholder"
MANAGEMENT_EMAIL="ops@example.com"
SAAS_CORE_SYSTEM_EMAIL_FROM="SaaS Core <noreply@example.com>"
SAAS_CORE_SYSTEM_EMAIL_REPLY_TO="support@example.com"

# ----------------------------------------------------------------------------
# Web Push
# Generate with: npx web-push generate-vapid-keys
# ----------------------------------------------------------------------------
WEB_PUSH_PUBLIC_KEY="your_vapid_public_key"
WEB_PUSH_PRIVATE_KEY="your_vapid_private_key"
WEB_PUSH_SUBJECT="mailto:ops@example.com"

# ----------------------------------------------------------------------------
# Privacy notice settings
# ----------------------------------------------------------------------------
PRIVACY_NOTICE_VERSION="YYYY-MM-DD-v1"
PRIVACY_NOTICE_DATA_CONTROLLER_NAME="SaaS Core"
PRIVACY_NOTICE_COUNTRY="Türkiye"
PRIVACY_NOTICE_CONTACT_EMAIL="support@example.com"
PRIVACY_NOTICE_CONTACT_PHONE="+00 000 000 0000"
PRIVACY_NOTICE_CONTACT_ADDRESS="Your business address"
PRIVACY_NOTICE_RETENTION_PERIOD="Describe the applicable retention period"
# Separate multiple recipients with semicolons.
PRIVACY_NOTICE_RECIPIENTS="Your business and authorized service providers"

# ----------------------------------------------------------------------------
# Optional tooling
# ----------------------------------------------------------------------------
SAAS_CORE_SCREENSHOT_EXECUTABLE_PATH=
# Set to 1 only for the isolated E2E build directory.
SAAS_CORE_E2E="0"
