# App
NODE_ENV=development
SAAS_CORE_VERSION=1.0.0
SAAS_CORE_SCHEMA_VERSION=1
APP_URL=http://localhost:3000
APP_NAME=Your SaaS Product

# Supabase (server-only service role values must never be exposed to browser code)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Billing (Paddle is optional for local Core Lab)
BILLING_PROVIDER=paddle
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=

# Email / push
RESEND_API_KEY=
RESEND_FROM_EMAIL=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:ops@example.com

# Domains / platform
SAAS_CORE_ROOT_DOMAIN=example.com
SAAS_CORE_APP_DOMAIN=app.example.com
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Operations
CRON_SECRET=
LOG_LEVEL=info

