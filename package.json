{
  "name": "saas-core",
  "version": "2.2.1",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.21.0 <12"
  },
  "scripts": {
    "build": "next build --webpack",
    "dev": "next dev",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "db:start": "supabase start --workdir .",
    "db:start:ci": "node scripts/start-local-supabase-ci.mjs",
    "db:stop": "supabase stop --workdir .",
    "db:reset": "supabase db reset --local --workdir .",
    "db:types": "node scripts/generate-local-types.mjs",
    "db:test:schema": "node scripts/test-core-schema.mjs",
    "db:test": "node scripts/run-local-supabase-tests.mjs",
    "db:test:clean": "node scripts/run-local-supabase-tests.mjs --reset",
    "auth:e2e": "node scripts/run-local-auth-e2e.mjs",
    "e2e:critical": "node scripts/run-local-playwright.mjs --grep @critical",
    "e2e:full": "node scripts/run-local-playwright.mjs --grep @e2e",
    "e2e:install": "playwright install chromium",
    "billing:register-price": "node scripts/billing-register-price.mjs",
    "billing:sync-catalog": "node scripts/billing-sync-catalog.mjs",
    "billing:reconcile": "node scripts/billing-reconcile.mjs",
    "domains:reconcile": "node scripts/domains-reconcile.mjs",
    "core:scan": "node scripts/core-scan.mjs",
    "core:commercial-scan": "node scripts/core-commercial-scan.mjs",
    "core:ui-fidelity": "node scripts/test-ui-source-fidelity.mjs",
    "core:lifecycle": "node scripts/test-core-lifecycle.mjs",
    "core:doctor-schema": "node scripts/test-doctor-schema.mjs",
    "core:catalog": "node scripts/test-billing-catalog.mjs",
    "core:pack": "node scripts/core-pack.mjs",
    "core:consumer-proof": "node scripts/consumer-proof.mjs",
    "core:source-parity": "node scripts/check-app-template-parity.mjs",
    "release:metadata": "node scripts/check-release-metadata.mjs",
    "release:packages": "node scripts/check-package-artifacts.mjs",
    "release:publish": "node scripts/publish-npm-release.mjs",
    "release:artifact-lifecycle": "node scripts/test-release-artifact-lifecycle.mjs",
    "release:recovery-proof": "node scripts/test-release-publication-recovery.mjs",
    "release:workflow-contract": "ruby scripts/test-release-workflow-contract.rb",
    "release:registry-preflight": "node scripts/check-registry-release.mjs --preflight",
    "release:registry-verify": "node scripts/check-registry-release.mjs --verify",
    "release:registry-install": "node scripts/registry-install-proof.mjs",
    "release:check": "node scripts/release-check.mjs",
    "core:init": "node scripts/core-init.mjs",
    "core:doctor": "node scripts/core-doctor.mjs",
    "core:diff": "node scripts/core-diff.mjs",
    "core:update": "node scripts/core-update.mjs",
    "pack": "pnpm run core:pack",
    "init": "pnpm run core:init",
    "doctor": "pnpm run core:doctor",
    "diff": "pnpm run core:diff",
    "update": "pnpm run core:update",
    "dev:local": "node scripts/run-with-local-supabase-env.mjs pnpm run dev",
    "build:local": "node scripts/run-with-local-supabase-env.mjs pnpm run build",
    "typecheck": "pnpm --filter @sapienx/saas-core build && pnpm --filter @sapienx/saas-core-config build && pnpm --filter @sapienx/saas-core-ui build && tsc --noEmit",
    "start": "next start"
  },
  "dependencies": {
    "@sapienx/saas-core": "workspace:*",
    "@hookform/resolvers": "^3.9.1",
    "@paddle/paddle-js": "1.6.4",
    "@paddle/paddle-node-sdk": "3.10.0",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-aspect-ratio": "1.1.1",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-collapsible": "1.1.2",
    "@radix-ui/react-context-menu": "2.2.4",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-hover-card": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-menubar": "1.1.4",
    "@radix-ui/react-navigation-menu": "1.2.3",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slider": "1.2.2",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-toggle": "1.1.1",
    "@radix-ui/react-toggle-group": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.6",
    "@react-email/render": "1.2.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "@types/web-push": "^3.6.4",
    "@vercel/sdk": "1.28.17",
    "autoprefixer": "^10.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.1",
    "geist": "^1.7.2",
    "input-otp": "1.4.1",
    "lucide-react": "^0.454.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-day-picker": "9.8.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^2.1.9",
    "recharts": "2.15.0",
    "resend": "6.0.0",
    "server-only": "0.0.1",
    "sharp": "0.35.3",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "thinking-orbs": "^0.2.0",
    "vaul": "1.1.2",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.5.26",
    "supabase": "2.113.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  }
}
